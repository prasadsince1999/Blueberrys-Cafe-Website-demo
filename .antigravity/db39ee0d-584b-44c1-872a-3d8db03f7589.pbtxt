    replacement_chunks {
      replacement_content: "import { motion, useScroll, useTransform } from \'motion/react\';\nimport { useRef } from \'react\';\nimport { PlaceholderImage } from \'./ui/PlaceholderImage\';\n\nexport function TheBlueberrysWorld() {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\"start end\", \"end start\"]\n  });\n\n  const y1 = useTransform(scrollYProgress, [0, 1], [0, -80]);\n  const y2 = useTransform(scrollYProgress, [0, 1], [40, -40]);\n  const y3 = useTransform(scrollYProgress, [0, 1], [80, -100]);\n\n  return (\n    <section className=\"py-24 md:py-32 bg-cafe-cream relative overflow-hidden\" ref={containerRef}>\n      \n      {/* Decorative Text */}\n      <div className=\"absolute top-0 left-0 w-full overflow-hidden pointer-events-none opacity-5 flex items-center justify-center pt-10\">\n        <span className=\"font-serif text-[15vw] whitespace-nowrap text-cafe-teal select-none\">\n          THE ATMOSPHERE\n        </span>\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12\">\n        <div className=\"grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 relative z-10 pt-20\">\n          \n          {/* Column 1 */}\n          <div className=\"md:col-span-5 flex flex-col gap-12 mt-12 md:mt-0\">\n            <motion.div style={{ y: y1 }} className=\"relative\">\n              <span className=\"absolute -top-6 left-0 text-[10px] tracking-widest text-cafe-teal uppercase\">The Space</span>\n              <PlaceholderImage label=\"Caf\303\251 Interior\" className=\"w-full aspect-[4/5] object-cover\" />\n            </motion.div>\n            \n            <motion.div style={{ y: y2 }} className=\"relative md:ml-12 w-3/4 self-end\">\n              <span className=\"absolute -top-6 left-0 text-[10px] tracking-widest text-cafe-teal uppercase\">The Details</span>\n              <PlaceholderImage label=\"Architectural Arch or Chandelier\" className=\"w-full aspect-square object-cover\" />\n            </motion.div>\n          </div>\n\n          {/* Column 2 */}\n          <div className=\"md:col-span-7 flex flex-col gap-12 md:pt-32\">\n            <motion.div style={{ y: y3 }} className=\"relative w-4/5\">\n              <span className=\"absolute -top-6 left-0 text-[10px] tracking-widest text-cafe-teal uppercase\">The Flowers</span>\n              <PlaceholderImage label=\"Floral Decor\" className=\"w-full aspect-[3/2] object-cover clip-path-arch\" />\n            </motion.div>\n            \n            <motion.div style={{ y: y1 }} className=\"relative w-full md:w-3/4 self-end md:-mt-12 z-20\">\n              <span className=\"absolute -top-6 left-0 text-[10px] tracking-widest text-cafe-teal uppercase\">The Moments</span>\n              <PlaceholderImage label=\"Customer Atmosphere\" className=\"w-full aspect-[4/3] object-cover shadow-xl\" />\n            </motion.div>\n          </div>\n\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    }
