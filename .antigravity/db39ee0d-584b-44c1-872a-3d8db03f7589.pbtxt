    replacement_chunks {
      target_content: "import { motion, useScroll, useTransform } from \'motion/react\';\nimport { useRef } from \'react\';\nimport { PlaceholderImage } from \'./ui/PlaceholderImage\';\n\nexport function Hero() {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\"start start\", \"end start\"]\n  });\n\n  const scale = useTransform(scrollYProgress, [0, 1], [1, 1.15]);\n  const y = useTransform(scrollYProgress, [0, 1], [0, 200]);\n  const opacity = useTransform(scrollYProgress, [0, 0.8], [1, 0]);\n\n  const archY = useTransform(scrollYProgress, [0, 1], [0, -100]);\n\n  return (\n    <section ref={containerRef} className=\"relative h-screen min-h-[700px] flex items-center justify-center overflow-hidden bg-cafe-ivory pt-20\">\n      \n      {/* Background Image Container with parallax */}\n      <motion.div \n        className=\"absolute inset-0 z-0\"\n        style={{ scale, y }}\n      >\n        <PlaceholderImage \n          label=\"Full Screen Interior Photo\" \n          className=\"w-full h-full object-cover\"\n        />\n        {/* Soft overlay to ensure text readability */}\n        <div className=\"absolute inset-0 bg-gradient-to-b from-cafe-ivory/40 via-transparent to-cafe-ivory/60\" />\n      </motion.div>\n\n      {/* Floating Floral Element */}\n      <motion.div \n        className=\"absolute top-1/4 right-[10%] w-64 h-80 z-10 hidden md:block clip-path-arch opacity-80\"\n        style={{ y: archY }}\n        initial={{ opacity: 0, y: 50 }}\n        animate={{ opacity: 0.8, y: 0 }}\n        transition={{ duration: 1.5, delay: 0.5, ease: \"easeOut\" }}\n      >\n        <PlaceholderImage label=\"Floral Detail\" className=\"w-full h-full\" />\n      </motion.div>\n\n      {/* Main Content Area */}\n      <motion.div \n        className=\"relative z-20 text-center px-6 max-w-4xl mx-auto mt-12\"\n        style={{ opacity }}\n      >\n        <motion.div\n          initial={{ opacity: 0, y: 30 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 1.2, ease: [0.16, 1, 0.3, 1] }}\n        >\n          <span className=\"text-cafe-teal uppercase tracking-[0.3em] text-sm font-medium block mb-6\">\n            Welcome to\n          </span>\n          <h1 className=\"font-serif text-5xl md:text-7xl lg:text-8xl text-cafe-teal mb-8 leading-tight\">\n            Where Every <br/>\n            <span className=\"italic text-cafe-pink\">Moment Blooms.</span>\n          </h1>\n        </motion.div>\n\n        <motion.p \n          className=\"text-cafe-text/80 text-lg md:text-xl font-light max-w-2xl mx-auto mb-12 leading-relaxed\"\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 1.2, delay: 0.2, ease: [0.16, 1, 0.3, 1] }}\n        >\n          Good food, beautiful spaces and little moments worth remembering.\n        </motion.p>\n\n        <motion.div \n          className=\"flex flex-col sm:flex-row items-center justify-center gap-6\"\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 1.2, delay: 0.4, ease: [0.16, 1, 0.3, 1] }}\n        >\n          <a href=\"#our-cafe\" className=\"px-8 py-4 bg-cafe-teal text-cafe-ivory uppercase tracking-[0.15em] text-sm font-medium hover:bg-cafe-text transition-colors w-full sm:w-auto\">\n            Explore the Caf\303\251\n          </a>\n          <a href=\"#menu\" className=\"px-8 py-4 border border-cafe-teal/30 text-cafe-teal uppercase tracking-[0.15em] text-sm font-medium hover:border-cafe-teal transition-colors w-full sm:w-auto\">\n            View Menu\n          </a>\n        </motion.div>\n      </motion.div>\n\n      {/* Scroll indicator */}\n      <motion.div \n        className=\"absolute bottom-10 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center opacity-60\"\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 0.6 }}\n        transition={{ duration: 1, delay: 1.5 }}\n      >\n        <span className=\"text-[10px] uppercase tracking-widest text-cafe-teal mb-3\">Scroll</span>\n        <div className=\"w-[1px] h-12 bg-cafe-teal/30 overflow-hidden\">\n          <motion.div \n            className=\"w-full h-1/2 bg-cafe-teal\"\n            animate={{ y: [\"-100%\", \"200%\"] }}\n            transition={{ repeat: Infinity, duration: 1.5, ease: \"linear\" }}\n          />\n        </div>\n      </motion.div>\n    </section>\n  );\n}"
      replacement_content: "import { motion, useScroll, useTransform } from \'motion/react\';\nimport { useRef } from \'react\';\nimport { PlaceholderImage } from \'./ui/PlaceholderImage\';\n\nexport function Hero() {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\"start start\", \"end start\"]\n  });\n\n  // Deep cinematic fly-through effect\n  const bgScale = useTransform(scrollYProgress, [0, 1], [1, 1.3]);\n  const bgOpacity = useTransform(scrollYProgress, [0, 1], [1, 0.4]);\n  const bgBlur = useTransform(scrollYProgress, [0, 1], [0, 10]);\n\n  const midY = useTransform(scrollYProgress, [0, 1], [0, -100]);\n  const midScale = useTransform(scrollYProgress, [0, 1], [1, 1.5]);\n  const midOpacity = useTransform(scrollYProgress, [0, 0.8], [1, 0]);\n\n  const fgY = useTransform(scrollYProgress, [0, 1], [0, -300]);\n  const fgScale = useTransform(scrollYProgress, [0, 1], [1, 2.5]);\n  \n  const textY = useTransform(scrollYProgress, [0, 1], [0, 150]);\n  const textOpacity = useTransform(scrollYProgress, [0, 0.5], [1, 0]);\n  const textBlur = useTransform(scrollYProgress, [0, 0.5], [0, 5]);\n\n  return (\n    <section ref={containerRef} className=\"relative h-screen min-h-[700px] flex items-center justify-center overflow-hidden bg-cafe-ivory\">\n      \n      {/* Background Layer */}\n      <motion.div \n        className=\"absolute inset-0 z-0 origin-center\"\n        style={{ \n          scale: bgScale, \n          opacity: bgOpacity,\n          filter: useTransform(bgBlur, v => `blur(${v}px)`) \n        }}\n      >\n        <PlaceholderImage \n          label=\"Cinematic Deep Background\" \n          className=\"w-full h-full object-cover\"\n        />\n        <div className=\"absolute inset-0 bg-gradient-to-b from-cafe-ivory/30 via-transparent to-cafe-ivory/80\" />\n      </motion.div>\n\n      {/* Midground Layer (Arch/Architecture) */}\n      <motion.div \n        className=\"absolute inset-0 z-10 flex items-center justify-center pointer-events-none opacity-40 mix-blend-multiply\"\n        style={{ scale: midScale, y: midY, opacity: midOpacity }}\n      >\n        <div className=\"w-[80vw] h-[90vh] border-[1px] border-cafe-teal rounded-[200px] rounded-b-none border-b-0\" />\n      </motion.div>\n\n      {/* Foreground Layer (Floral cutouts) */}\n      <motion.div \n        className=\"absolute -bottom-20 -left-20 w-[40vw] max-w-lg aspect-square z-30 pointer-events-none\"\n        style={{ scale: fgScale, y: fgY }}\n      >\n        <PlaceholderImage label=\"Foreground Floral Alpha\" className=\"w-full h-full object-cover clip-path-arch opacity-80\" />\n      </motion.div>\n\n      <motion.div \n        className=\"absolute -top-20 -right-20 w-[30vw] max-w-sm aspect-square z-30 pointer-events-none\"\n        style={{ scale: fgScale, y: useTransform(scrollYProgress, [0, 1], [0, 200]) }}\n      >\n        <PlaceholderImage label=\"Foreground Leaves Alpha\" className=\"w-full h-full object-cover rounded-full opacity-60\" />\n      </motion.div>\n\n      {/* Main Content Area */}\n      <motion.div \n        className=\"relative z-20 text-center px-6 max-w-4xl mx-auto mt-20\"\n        style={{ \n          opacity: textOpacity, \n          y: textY,\n          filter: useTransform(textBlur, v => `blur(${v}px)`)\n        }}\n      >\n        <motion.div\n          initial={{ opacity: 0, y: 30, filter: \'blur(10px)\' }}\n          animate={{ opacity: 1, y: 0, filter: \'blur(0px)\' }}\n          transition={{ duration: 1.5, ease: [0.16, 1, 0.3, 1] }}\n        >\n          <span className=\"text-cafe-teal uppercase tracking-[0.4em] text-xs font-medium block mb-8\">\n            Welcome to\n          </span>\n          <h1 className=\"font-serif text-6xl md:text-8xl lg:text-9xl text-cafe-teal mb-8 leading-[0.9] tracking-tighter\">\n            Where Every <br/>\n            <span className=\"italic text-cafe-pink font-light tracking-normal pr-4\">Moment Blooms.</span>\n          </h1>\n        </motion.div>\n\n        <motion.p \n          className=\"text-cafe-text/80 text-lg md:text-2xl font-light max-w-2xl mx-auto mb-12 leading-relaxed\"\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 1.5, delay: 0.3, ease: [0.16, 1, 0.3, 1] }}\n        >\n          Good food, beautiful spaces and little moments worth remembering.\n        </motion.div>\n\n        <motion.div \n          className=\"flex flex-col sm:flex-row items-center justify-center gap-6\"\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 1.5, delay: 0.5, ease: [0.16, 1, 0.3, 1] }}\n        >\n          <a href=\"#our-cafe\" className=\"px-10 py-5 bg-cafe-teal text-cafe-ivory uppercase tracking-[0.2em] text-xs font-medium hover:bg-cafe-text transition-colors w-full sm:w-auto relative overflow-hidden group\">\n            <span className=\"relative z-10\">Explore the Caf\303\251</span>\n            <div className=\"absolute inset-0 bg-cafe-text transform scale-x-0 group-hover:scale-x-100 transition-transform origin-left duration-500\" />\n          </a>\n          <a href=\"#menu\" className=\"px-10 py-5 border border-cafe-teal/30 text-cafe-teal uppercase tracking-[0.2em] text-xs font-medium hover:border-cafe-teal transition-all w-full sm:w-auto relative group overflow-hidden\">\n            <span className=\"relative z-10 group-hover:text-cafe-ivory transition-colors duration-500\">View Menu</span>\n            <div className=\"absolute inset-0 bg-cafe-teal transform scale-y-0 group-hover:scale-y-100 transition-transform origin-bottom duration-500\" />\n          </a>\n        </motion.div>\n      </motion.div>\n\n      {/* Scroll indicator */}\n      <motion.div \n        className=\"absolute bottom-10 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center mix-blend-multiply\"\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 0.6 }}\n        transition={{ duration: 1, delay: 2 }}\n        style={{ opacity: textOpacity }}\n      >\n        <span className=\"text-[9px] uppercase tracking-[0.3em] text-cafe-teal mb-4\">Scroll</span>\n        <div className=\"w-[1px] h-16 bg-cafe-teal/20 overflow-hidden relative\">\n          <motion.div \n            className=\"absolute top-0 left-0 w-full h-1/2 bg-cafe-teal\"\n            animate={{ y: [\"-100%\", \"200%\"] }}\n            transition={{ repeat: Infinity, duration: 2, ease: \"easeInOut\" }}\n          />\n        </div>\n      </motion.div>\n    </section>\n  );\n}"
    }
