    replacement_chunks {
      replacement_content: "import { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { PlaceholderImage } from \'./ui/PlaceholderImage\';\nimport { MenuOverlay } from \'./MenuOverlay\';\nimport { cn } from \'../lib/utils\';\n\nconst CATEGORIES = [\n  \'PASTA\',\n  \'PIZZA\',\n  \'SANDWICHES\',\n  \'COFFEE\',\n  \'DRINKS\'\n];\n\nexport function MenuSection() {\n  const [activeCategory, setActiveCategory] = useState(CATEGORIES[0]);\n  const [isOverlayOpen, setIsOverlayOpen] = useState(false);\n\n  return (\n    <section id=\"menu\" className=\"py-24 md:py-32 bg-cafe-ivory relative border-t border-cafe-teal/10\">\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12\">\n        \n        <div className=\"text-center mb-16 md:mb-24\">\n          <motion.h2 \n            initial={{ opacity: 0, y: 20 }}\n            whileInView={{ opacity: 1, y: 0 }}\n            viewport={{ once: true }}\n            className=\"font-serif text-4xl md:text-5xl lg:text-6xl text-cafe-teal italic\"\n          >\n            Something Delicious<br/>Is Waiting.\n          </motion.h2>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-24 items-center\">\n          \n          {/* Categories / Interactive List */}\n          <div className=\"lg:col-span-5 flex flex-col gap-6 order-2 lg:order-1\">\n            {CATEGORIES.map((category) => (\n              <button\n                key={category}\n                onClick={() => setActiveCategory(category)}\n                className=\"group text-left py-4 border-b border-cafe-teal/10 relative overflow-hidden\"\n              >\n                <div className=\"flex items-center justify-between relative z-10\">\n                  <span className={cn(\n                    \"text-xl md:text-3xl font-serif transition-colors duration-500\",\n                    activeCategory === category ? \"text-cafe-pink italic\" : \"text-cafe-teal group-hover:text-cafe-teal/70\"\n                  )}>\n                    {category}\n                  </span>\n                  <span className={cn(\n                    \"text-xs tracking-[0.2em] uppercase transition-opacity duration-500\",\n                    activeCategory === category ? \"opacity-100 text-cafe-text\" : \"opacity-0\"\n                  )}>\n                    Explore\n                  </span>\n                </div>\n                \n                {/* Active Indicator */}\n                {activeCategory === category && (\n                  <motion.div \n                    layoutId=\"activeCategoryBg\"\n                    className=\"absolute inset-0 bg-gradient-to-r from-cafe-cream to-transparent -z-0\"\n                    initial={{ opacity: 0 }}\n                    animate={{ opacity: 1 }}\n                    exit={{ opacity: 0 }}\n                  />\n                )}\n              </button>\n            ))}\n\n            <div className=\"mt-8 pt-8\">\n              <button \n                onClick={() => setIsOverlayOpen(true)}\n                className=\"w-full sm:w-auto px-10 py-5 bg-cafe-teal text-cafe-ivory uppercase tracking-[0.15em] text-sm font-medium hover:bg-cafe-text transition-colors text-center\"\n              >\n                Explore Full Menu\n              </button>\n            </div>\n          </div>\n\n          {/* Visual Showcase */}\n          <div className=\"lg:col-span-7 h-[60vh] min-h-[400px] max-h-[700px] order-1 lg:order-2\">\n            <div className=\"w-full h-full relative overflow-hidden rounded-t-full\">\n              <AnimatePresence mode=\"wait\">\n                <motion.div\n                  key={activeCategory}\n                  initial={{ opacity: 0, scale: 1.05 }}\n                  animate={{ opacity: 1, scale: 1 }}\n                  exit={{ opacity: 0, scale: 0.95 }}\n                  transition={{ duration: 0.7, ease: [0.16, 1, 0.3, 1] }}\n                  className=\"absolute inset-0\"\n                >\n                  <PlaceholderImage \n                    label={`${activeCategory} Photography`} \n                    className=\"w-full h-full object-cover\"\n                  />\n                </motion.div>\n              </AnimatePresence>\n            </div>\n          </div>\n\n        </div>\n      </div>\n\n      <MenuOverlay isOpen={isOverlayOpen} onClose={() => setIsOverlayOpen(false)} />\n    </section>\n  );\n}\n"
    }
