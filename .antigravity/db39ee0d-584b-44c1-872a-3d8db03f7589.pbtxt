 group overflow-hidden ${img.className}`}\n                style={{ y: yOffset }}\n                initial={{ opacity: 0, y: 20 }}\n                whileInView={{ opacity: 1, y: 0 }}\n                viewport={{ once: true, margin: \"-50px\" }}\n                transition={{ duration: 0.8, delay: index * 0.1 }}\n              >\n                <PlaceholderImage \n                  label={img.label} \n                  className=\"w-full h-full object-cover transition-transform duration-700 group-hover:scale-105\" \n                />\n                \n                {/* Hover Overlay */}\n                <div className=\"absolute inset-0 bg-cafe-teal/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center\">\n                  <span className=\"text-cafe-ivory tracking-[0.2em] text-sm font-medium uppercase translate-y-4 group-hover:translate-y-0 transition-transform duration-500\">\n                    {img.label}\n                  </span>\n                </div>\n              </motion.div>\n            );\n          })}\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    }
