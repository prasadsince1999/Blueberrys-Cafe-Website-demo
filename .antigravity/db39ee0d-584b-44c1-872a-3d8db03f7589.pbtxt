  file_change {
    absolute_path_uri: "file:///src/components/CafeExperience.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import { motion, useScroll, useTransform } from \'motion/react\';\nimport { useRef } from \'react\';\nimport { PlaceholderImage } from \'./ui/PlaceholderImage\';\n\nexport function CafeExperience() {\n  const containerRef = useRef<HTMLDivElement>(null);\n  \n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\"start start\", \"end end\"]\n  });\n\n  const scale = useTransform(scrollYProgress, [0, 0.4], [1, 1.3]);\n  const overlayOpacity = useTransform(scrollYProgress, [0, 0.3, 0.5], [0, 0.5, 0.7]);\n  const textOpacity = useTransform(scrollYProgress, [0.3, 0.5, 0.8, 1], [0, 1, 1, 0]);\n  const textY = useTransform(scrollYProgress, [0.3, 0.5], [50, 0]);\n\n  // Small detail images\n  const detail1Opacity = useTransform(scrollYProgress, [0.5, 0.65], [0, 1]);\n  const detail1Y = useTransform(scrollYProgress, [0.5, 0.65], [30, 0]);\n  \n  const detail2Opacity = useTransform(scrollYProgress, [0.6, 0.75], [0, 1]);\n  const detail2Y = useTransform(scrollYProgress, [0.6, 0.75], [30, 0]);\n\n  return (\n    <section id=\"experience\" ref={containerRef} className=\"h-[300vh] bg-cafe-teal relative\">\n      <div className=\"sticky top-0 h-screen w-full overflow-hidden flex items-center justify-center\">\n        \n        {/* Main Background Image */}\n        <motion.div className=\"absolute inset-0 origin-center\" style={{ scale }}>\n          <PlaceholderImage \n            label=\"Cinematic Caf\303\251 Experience\" \n            className=\"w-full h-full object-cover\"\n          />\n        </motion.div>\n        \n        {/* Darkening Overlay */}\n        <motion.div \n          className=\"absolute inset-0 bg-cafe-teal mix-blend-multiply\" \n          style={{ opacity: overlayOpacity }}\n        />\n\n        {/* Center Text */}\n        <motion.div \n          className=\"relative z-20 text-center px-6 max-w-3xl\"\n          style={{ opacity: textOpacity, y: textY }}\n        >\n          <h2 className=\"font-serif text-5xl md:text-7xl lg:text-8xl text-cafe-ivory leading-tight text-balance\">\n            Come for the food. <br/>\n            <span className=\"italic text-cafe-pink\">Stay for the atmosphere.</span>\n          </h2>\n        </motion.div>\n\n        {/* Small floating details */}\n        <motion.div \n          className=\"absolute top-1/4 left-10 md:left-24 w-40 md:w-64 aspect-[3/4] z-30 shadow-2xl hidden md:block\"\n          style={{ opacity: detail1Opacity, y: detail1Y }}\n        >\n          <PlaceholderImage label=\"Detail 1\" className=\"w-full h-full object-cover border-4 border-cafe-ivory/20\" />\n        </motion.div>\n\n        <motion.div \n          className=\"absolute bottom-1/4 right-10 md:right-24 w-48 md:w-72 aspect-square z-30 shadow-2xl hidden md:block\"\n          style={{ opacity: detail2Opacity, y: detail2Y }}\n        >\n          <PlaceholderImage label=\"Detail 2\" className=\"w-full h-full object-cover rounded-full border-4 border-cafe-pink/20\" />\n        </motion.div>\n\n      </div>\n    </section>\n  );\n}"
      replacement_content: "import { motion, useScroll, useTransform } from \'motion/react\';\nimport { useRef } from \'react\';\nimport { PlaceholderImage } from \'./ui/PlaceholderImage\';\n\nexport function CafeExperience() {\n  const containerRef = useRef<HTMLDivElement>(null);\n  \n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\"start start\", \"end end\"]\n  });\n\n  const scale = useTransform(scrollYProgress, [0, 0.5, 1], [1, 1.4, 2]);\n  const blur = useTransform(scrollYProgress, [0, 0.2, 0.4, 0.6, 1], [10, 0, 0, 5, 20]);\n  \n  const overlayOpacity = useTransform(scrollYProgress, [0, 0.2, 0.4, 0.6, 1], [0.8, 0.3, 0.3, 0.7, 1]);\n  \n  const textOpacity = useTransform(scrollYProgress, [0.1, 0.3, 0.6, 0.8], [0, 1, 1, 0]);\n  const textY = useTransform(scrollYProgress, [0.1, 0.3, 0.6, 0.8], [50, 0, 0, -50]);\n  const textScale = useTransform(scrollYProgress, [0.1, 0.8], [0.9, 1.1]);\n\n  // Small detail images - floating past camera\n  const detail1Opacity = useTransform(scrollYProgress, [0.3, 0.45, 0.6], [0, 1, 0]);\n  const detail1Y = useTransform(scrollYProgress, [0.3, 0.6], [200, -200]);\n  const detail1Scale = useTransform(scrollYProgress, [0.3, 0.6], [0.8, 1.5]);\n  \n  const detail2Opacity = useTransform(scrollYProgress, [0.4, 0.55, 0.7], [0, 1, 0]);\n  const detail2Y = useTransform(scrollYProgress, [0.4, 0.7], [200, -200]);\n  const detail2Scale = useTransform(scrollYProgress, [0.4, 0.7], [0.8, 1.5]);\n\n  return (\n    <section id=\"experience\" ref={containerRef} className=\"h-[400vh] bg-[#0c1a1c] relative\">\n      <div className=\"sticky top-0 h-screen w-full overflow-hidden flex items-center justify-center\">\n        \n        {/* Main Background Image - Deep Zoom & Blur */}\n        <motion.div \n          className=\"absolute inset-0 origin-center\" \n          style={{ \n            scale, \n            filter: useTransform(blur, v => `blur(${v}px)`) \n          }}\n        >\n          <PlaceholderImage \n            label=\"Cinematic Night Caf\303\251 Experience\" \n            className=\"w-full h-full object-cover opacity-80\"\n          />\n        </motion.div>\n        \n        {/* Darkening Overlay for mood */}\n        <motion.div \n          className=\"absolute inset-0 bg-[#0c1a1c] mix-blend-multiply\" \n          style={{ opacity: overlayOpacity }}\n        />\n\n        {/* Center Text */}\n        <motion.div \n          className=\"relative z-20 text-center px-6 max-w-4xl\"\n          style={{ opacity: textOpacity, y: textY, scale: textScale }}\n        >\n          <h2 className=\"font-serif text-5xl md:text-7xl lg:text-9xl text-cafe-ivory leading-[0.9] tracking-tight\">\n            Come for the food. <br/>\n            <span className=\"italic text-cafe-pink font-light tracking-normal pr-4\">Stay for the atmosphere.</span>\n          </h2>\n        </motion.div>\n\n        {/* Floating Details (Parallaxing intensely) */}\n        <motion.div \n          className=\"absolute top-[20%] left-[10%] md:left-[20%] w-[30vw] max-w-sm aspect-[3/4] z-30 hidden md:block\"\n          style={{ opacity: detail1Opacity, y: detail1Y, scale: detail1Scale }}\n        >\n          <PlaceholderImage label=\"Floating Chandelier Alpha\" className=\"w-full h-full object-cover clip-path-arch shadow-2xl\" />\n        </motion.div>\n\n        <motion.div \n          className=\"absolute bottom-[20%] right-[10%] md:right-[20%] w-[25vw] max-w-xs aspect-square z-30 hidden md:block\"\n          style={{ opacity: detail2Opacity, y: detail2Y, scale: detail2Scale }}\n        >\n          <PlaceholderImage label=\"Floating Rose Alpha\" className=\"w-full h-full object-cover rounded-full shadow-2xl mix-blend-screen\" />\n        </motion.div>\n\n      </div>\n    </section>\n  );\n}"
    }
