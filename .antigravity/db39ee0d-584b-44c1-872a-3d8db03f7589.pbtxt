    web_documents {
      url: "https://vertexaisearch.cloud.google.com/grounding-api-redirect/AUZIYQHLbI2j8lKLfrasIKKwoxtwHhUOYeeM5-M271ZGBgRyergNzykqWe0yA9ZUsPuyBD30QEa6tKzeWc9fQRsb_2JJtQK_jq-4DP0ZCpHJQGGkSP3JP1Q2vwV_cMenELEcH-5CANxlrEc5ctrIrMVc"
