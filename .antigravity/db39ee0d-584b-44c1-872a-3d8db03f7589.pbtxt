    replacement_chunks {
      target_content: "@import \"tailwindcss\";\n"
      replacement_content: "@import \"tailwindcss\";\n\n@theme {\n  --color-cafe-blue: #75C9D0;\n  --color-cafe-teal: #155E68;\n  --color-cafe-cream: #F8F1E5;\n  --color-cafe-ivory: #FFF9EF;\n  --color-cafe-pink: #E98FA7;\n  --color-cafe-blossom: #C94F72;\n  --color-cafe-rose: #D97891;\n  --color-cafe-green: #557B58;\n  --color-cafe-gold: #D6B46A;\n  --color-cafe-text: #24383A;\n  \n  --font-serif: \"Playfair Display\", serif;\n  --font-sans: \"Manrope\", sans-serif;\n}\n\n@layer base {\n  html {\n    @apply antialiased scroll-smooth;\n    font-family: var(--font-sans);\n    color: var(--color-cafe-text);\n    background-color: var(--color-cafe-ivory);\n  }\n\n  body {\n    @apply m-0 p-0 overflow-x-hidden;\n  }\n  \n  h1, h2, h3, h4, h5, h6 {\n    font-family: var(--font-serif);\n  }\n}\n\n@layer utilities {\n  .text-balance {\n    text-wrap: balance;\n  }\n  \n  .clip-path-arch {\n    clip-path: polygon(50% 0%, 100% 20%, 100% 100%, 0% 100%, 0% 20%);\n    /* Better arch for decorative elements */\n    clip-path: path(\'M0,100 L0,50 C0,22 22,0 50,0 C78,0 100,22 100,50 L100,100 Z\');\n  }\n\n  .clip-path-inset {\n    clip-path: inset(0 0 0 0);\n  }\n  \n  .clip-path-inset-100 {\n    clip-path: inset(0 0 100% 0);\n  }\n}\n\n/* Lenis Recommended Styles */\nhtml.lenis, html.lenis body {\n  height: auto;\n}\n\n.lenis.lenis-smooth {\n  scroll-behavior: auto !important;\n}\n\n.lenis.lenis-smooth [data-lenis-prevent] {\n  overscroll-behavior: contain;\n}\n\n.lenis.lenis-stopped {\n  overflow: hidden;\n}\n\n.lenis.lenis-scrolling iframe {\n  pointer-events: none;\n}\n"
    }
