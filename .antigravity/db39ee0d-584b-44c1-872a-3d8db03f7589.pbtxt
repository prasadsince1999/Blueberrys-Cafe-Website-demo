    replacement_chunks {
      replacement_content: "import { motion, useScroll, useTransform } from \'motion/react\';\nimport { useRef } from \'react\';\nimport { PlaceholderImage } from \'./ui/PlaceholderImage\';\n\nexport function SignatureIntroduction() {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\"start end\", \"end start\"]\n  });\n\n  const imageY = useTransform(scrollYProgress, [0, 1], [50, -50]);\n\n  return (\n    <section id=\"our-cafe\" ref={containerRef} className=\"py-24 md:py-40 bg-cafe-ivory relative\">\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12\">\n        <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center\">\n          \n          <div className=\"lg:col-span-5 lg:col-start-1 relative z-10\">\n            <motion.div\n              initial={{ opacity: 0, y: 30 }}\n              whileInView={{ opacity: 1, y: 0 }}\n              viewport={{ once: true, margin: \"-100px\" }}\n              transition={{ duration: 1, ease: [0.16, 1, 0.3, 1] }}\n            >\n              <h2 className=\"font-serif text-5xl md:text-6xl lg:text-7xl text-cafe-teal mb-8 italic leading-tight\">\n                More than <br className=\"hidden md:block\" />a caf\303\251.\n              </h2>\n              <p className=\"text-xl md:text-2xl text-cafe-text/90 font-light leading-relaxed text-balance\">\n                A place for coffee, conversations, celebrations, quick bites, long lunches and photographs you\'ll want to keep.\n              </p>\n            </motion.div>\n          </div>\n\n          <div className=\"lg:col-span-6 lg:col-start-7 relative mt-12 lg:mt-0\">\n            {/* Decorative background shape */}\n            <div className=\"absolute -inset-4 bg-cafe-cream -z-10 rounded-tl-full rounded-br-full opacity-60 mix-blend-multiply\" />\n            \n            <motion.div \n              style={{ y: imageY }}\n              className=\"relative aspect-[3/4] md:aspect-[4/5] w-full\"\n            >\n              <PlaceholderImage \n                label=\"Large Interior or Atmosphere Photo\" \n                className=\"w-full h-full object-cover rounded-sm shadow-2xl shadow-cafe-teal/5\"\n              />\n              \n              {/* Overlapping small detail image */}\n              <motion.div \n                className=\"absolute -bottom-10 -left-10 w-2/5 aspect-square border-8 border-cafe-ivory hidden md:block\"\n                initial={{ opacity: 0, scale: 0.8 }}\n                whileInView={{ opacity: 1, scale: 1 }}\n                viewport={{ once: true, margin: \"-50px\" }}\n                transition={{ duration: 0.8, delay: 0.3 }}\n              >\n                <PlaceholderImage label=\"Coffee Cup Detail\" className=\"w-full h-full object-cover\" />\n              </motion.div>\n            </motion.div>\n          </div>\n\n        </div>\n      </div>\n    </section>\n  );\n}\n"
    }
