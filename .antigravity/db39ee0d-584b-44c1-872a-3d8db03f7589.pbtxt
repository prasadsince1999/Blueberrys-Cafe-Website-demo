  file_change {
    absolute_path_uri: "file:///src/components/MenuOverlay.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { motion, AnimatePresence } from \'motion/react\';\nimport { X } from \'lucide-react\';\nimport { useEffect } from \'react\';\n\ninterface MenuOverlayProps {\n  isOpen: boolean;\n  onClose: () => void;\n}\n\nconst MENU_DATA = [\n  {\n    category: \'PASTA\',\n    items: [\n      { name: \'ALFREDO PASTA\', price: \'\342\202\271389 / \342\202\271419\', desc: \'Rich and creamy white sauce\' },\n      { name: \'CREAMY CHEESE & GARLIC PASTA\', price: \'\342\202\271369 / \342\202\271399\', desc: \'Loaded with cheese and roasted garlic\' },\n      { name: \'ARRABBIATA PASTA\', price: \'\342\202\271359 / \342\202\271389\', desc: \'Spicy tomato basil sauce\' },\n    ]\n  },\n  {\n    category: \'COFFEE\',\n    items: [\n      { name: \'CAPPUCCINO\', price: \'\342\202\271180\', desc: \'Classic espresso with steamed milk foam\' },\n      { name: \'ICED AMERICANO\', price: \'\342\202\271160\', desc: \'Chilled espresso over water and ice\' },\n      { name: \'MOCHA FLAPPE\', price: \'\342\202\271220\', desc: \'Blended chocolate, espresso and cream\' },\n    ]\n  }\n  // Add other categories as needed...\n];\n\nexport function MenuOverlay({ isOpen, onClose }: MenuOverlayProps) {\n  \n  // Lock body scroll when open\n  useEffect(() => {\n    if (isOpen) {\n      document.body.style.overflow = \'hidden\';\n    } else {\n      document.body.style.overflow = \'auto\';\n    }\n    return () => {\n      document.body.style.overflow = \'auto\';\n    };\n  }, [isOpen]);\n\n  return (\n    <AnimatePresence>\n      {isOpen && (\n        <motion.div\n          initial={{ opacity: 0, y: \"100%\" }}\n          animate={{ opacity: 1, y: 0 }}\n          exit={{ opacity: 0, y: \"100%\" }}\n          transition={{ duration: 0.8, ease: [0.16, 1, 0.3, 1] }}\n          className=\"fixed inset-0 z-[100] bg-cafe-cream overflow-y-auto\"\n        >\n          {/* Decorative background texture */}\n          <div className=\"fixed inset-0 opacity-[0.03] pointer-events-none bg-[url(\'https://www.transparenttextures.com/patterns/cream-paper.png\')]\" />\n          \n          {/* Close button */}\n          <button \n            onClick={onClose}\n            className=\"fixed top-8 right-8 z-[110] p-4 bg-cafe-teal text-cafe-ivory rounded-full hover:bg-cafe-text transition-colors shadow-lg\"\n          >\n            <X size={24} strokeWidth={1.5} />\n          </button>\n\n          <div className=\"max-w-4xl mx-auto px-6 py-24 relative z-10\">\n            <div className=\"text-center mb-20\">\n              <span className=\"text-cafe-pink uppercase tracking-[0.3em] text-sm font-medium mb-4 block\">Blueberrys</span>\n              <h2 className=\"font-serif text-5xl md:text-7xl text-cafe-teal border-b-2 border-cafe-teal/20 pb-8 inline-block px-12\">\n                Our Menu\n              </h2>\n            </div>\n\n            <div className=\"grid gap-20\">\n              {MENU_DATA.map((section, idx) => (\n                <motion.div \n                  key={section.category}\n                  initial={{ opacity: 0, y: 30 }}\n                  whileInView={{ opacity: 1, y: 0 }}\n                  viewport={{ once: true, margin: \"-100px\" }}\n                  transition={{ duration: 0.6, delay: idx * 0.1 }}\n                >\n                  <h3 className=\"font-serif text-3xl md:text-4xl text-cafe-pink italic mb-8 text-center md:text-left\">\n                    {section.category}\n                  </h3>\n                  \n                  <div className=\"grid gap-6\">\n                    {section.items.map((item) => (\n                      <div key={item.name} className=\"flex flex-col border-b border-cafe-teal/10 pb-4\">\n                        <div className=\"flex justify-between items-baseline mb-1\">\n                          <h4 className=\"font-sans text-cafe-teal font-semibold tracking-wide uppercase text-sm md:text-base pr-4\">\n                            {item.name}\n                          </h4>\n                          <span className=\"font-serif text-cafe-text/80 whitespace-nowrap\">\n                            {item.price}\n                          </span>\n                        </div>\n                        <p className=\"text-cafe-text/60 text-sm font-light italic\">\n                          {item.desc}\n                        </p>\n                      </div>\n                    ))}\n                  </div>\n                </motion.div>\n              ))}\n            </div>\n            \n            <div className=\"mt-24 text-center pb-24\">\n              <p className=\"font-serif italic text-cafe-teal/60 text-xl\">\n                Please ask us about our seasonal specials.\n              </p>\n            </div>\n          </div>\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n}\n"
    }
