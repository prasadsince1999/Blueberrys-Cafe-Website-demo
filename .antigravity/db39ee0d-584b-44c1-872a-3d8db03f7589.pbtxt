    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { motion, useScroll, useTransform } from \'motion/react\';\nimport { useRef } from \'react\';\nimport { PlaceholderImage } from \'./ui/PlaceholderImage\';\n\nexport function Hero() {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\"start start\", \"end start\"]\n  });\n\n  const scale = useTransform(scrollYProgress, [0, 1], [1, 1.15]);\n  const y = useTransform(scrollYProgress, [0, 1], [0, 200]);\n  const opacity = useTransform(scrollYProgress, [0, 0.8], [1, 0]);\n\n  const archY = useTransform(scrollYProgress, [0, 1], [0, -100]);\n\n  return (\n    <section ref={containerRef} className=\"relative h-screen min-h-[700px] flex items-center justify-center overflow-hidden bg-cafe-ivory pt-20\">\n      \n      {/* Background Image Container with parallax */}\n      <motion.div \n        className=\"absolute inset-0 z-0\"\n        style={{ scale, y }}\n      >\n        <PlaceholderImage \n          label=\"Full Screen Interior Photo\" \n          className=\"w-full h-full object-cover\"\n        />\n        {/* Soft overlay to ensure text readability */}\n        <div className=\"absolute inset-0 bg-gradient-to-b from-cafe-ivory/40 via-transparent to-cafe-ivory/60\" />\n      </motion.div>\n\n      {/* Floating Floral Element */}\n      <motion.div \n        className=\"absolute top-1/4 right-[10%] w-64 h-80 z-10 hidden md:block clip-path-arch opacity-80\"\n        style={{ y: archY }}\n        initial={{ opacity: 0, y: 50 }}\n        animate={{ opacity: 0.8, y: 0 }}\n        transition={{ duration: 1.5, delay: 0.5, ease: \"easeOut\" }}\n      >\n        <PlaceholderImage label=\"Floral Detail\" className=\"w-full h-full\" />\n      </motion.div>\n\n      {/* Main Content Area */}\n      <motion.div \n        className=\"relative z-20 text-center px-6 max-w-4xl mx-auto mt-12\"\n        style={{ opacity }}\n      >\n        <motion.div\n          initial={{ opacity: 0, y: 30 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 1.2, ease: [0.16, 1, 0.3, 1] }}\n        >\n          <span className=\"text-cafe-teal uppercase tracking-[0.3em] text-sm font-medium block mb-6\">\n            Welcome to\n          </span>\n          <h1 className=\"font-serif text-5xl md:text-7xl lg:text-8xl text-cafe-teal mb-8 leading-tight\">\n            Where Every <br/>\n            <span className=\"italic text-cafe-pink\">Moment Blooms.</span>\n          </h1>\n        </motion.div>\n\n        <motion.p \n          className=\"text-cafe-text/80 text-lg md:text-xl font-light max-w-2xl mx-auto mb-12 leading-relaxed\"\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 1.2, delay: 0.2, ease: [0.16, 1, 0.3, 1] }}\n        >\n          Good food, beautiful spaces and little moments worth remembering.\n        </motion.p>\n\n        <motion.div \n          className=\"flex flex-col sm:flex-row items-center justify-center gap-6\"\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ duration: 1.2, delay: 0.4, ease: [0.16, 1, 0.3, 1] }}\n        >\n          <a href=\"#our-cafe\" className=\"px-8 py-4 bg-cafe-teal text-cafe-ivory uppercase tracking-[0.15em] text-sm font-medium hover:bg-cafe-text transition-colors w-full sm:w-auto\">\n            Explore the Caf\303\251\n          </a>\n          <a href=\"#menu\" className=\"px-8 py-4 border border-cafe-teal/30 text-cafe-teal uppercase tracking-[0.15em] text-sm font-medium hover:border-cafe-teal transition-colors w-full sm:w-auto\">\n            View Menu\n          </a>\n        </motion.div>\n      </motion.div>\n\n      {/* Scroll indicator */}\n      <motion.div \n        className=\"absolute bottom-10 left-1/2 -translate-x-1/2 z-20 flex flex-col items-center opacity-60\"\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 0.6 }}\n        transition={{ duration: 1, delay: 1.5 }}\n      >\n        <span className=\"text-[10px] uppercase tracking-widest text-cafe-teal mb-3\">Scroll</span>\n        <div className=\"w-[1px] h-12 bg-cafe-teal/30 overflow-hidden\">\n          <motion.div \n            className=\"w-full h-1/2 bg-cafe-teal\"\n            animate={{ y: [\"-100%\", \"200%\"] }}\n            transition={{ repeat: Infinity, duration: 1.5, ease: \"linear\" }}\n          />\n        </div>\n      </motion.div>\n    </section>\n  );\n}\n"
    }
