  file_change {
    absolute_path_uri: "file:///src/components/Preloader.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { useEffect, useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { useLenis } from \'lenis/react\';\n\nexport function Preloader() {\n  const [isLoading, setIsLoading] = useState(true);\n  const lenis = useLenis();\n\n  useEffect(() => {\n    // Lock scrolling while the preloader is active\n    if (lenis) {\n      if (isLoading) {\n        lenis.stop();\n      } else {\n        lenis.start();\n      }\n    }\n  }, [lenis, isLoading]);\n\n  useEffect(() => {\n    // Lock body scroll as a fallback\n    document.body.style.overflow = isLoading ? \'hidden\' : \'auto\';\n\n    // Ensure we show the preloader for at least 2.5 seconds for the cinematic effect\n    const minTime = new Promise(resolve => setTimeout(resolve, 2500));\n    \n    // Check if document is fully loaded\n    const checkLoad = new Promise(resolve => {\n      if (document.readyState === \'complete\') {\n        resolve(true);\n      } else {\n        window.addEventListener(\'load\', () => resolve(true));\n      }\n    });\n\n    // Wait for both the minimum time and the page to fully load\n    Promise.all([minTime, checkLoad]).then(() => {\n      setIsLoading(false);\n    });\n\n    return () => {\n      document.body.style.overflow = \'auto\';\n    };\n  }, [isLoading]);\n\n  return (\n    <AnimatePresence>\n      {isLoading && (\n        <motion.div\n          className=\"fixed inset-0 z-[10000] bg-cafe-cream flex flex-col items-center justify-center overflow-hidden\"\n          initial={{ opacity: 1 }}\n          exit={{ y: \"-100%\", opacity: 1 }}\n          transition={{ duration: 1.2, ease: [0.76, 0, 0.24, 1] }}\n        >\n          {/* Subtle background texture */}\n          <div className=\"absolute inset-0 opacity-[0.05] mix-blend-multiply bg-[url(\'https://www.transparenttextures.com/patterns/cream-paper.png\')]\" />\n          \n          <div className=\"relative z-10 flex flex-col items-center\">\n            {/* Custom SVG Floral Drawing Animation */}\n            <motion.svg \n              width=\"64\" \n              height=\"64\" \n              viewBox=\"0 0 24 24\" \n              fill=\"none\" \n              stroke=\"currentColor\" \n              strokeWidth=\"0.5\" \n              strokeLinecap=\"round\" \n              strokeLinejoin=\"round\" \n              className=\"text-cafe-teal mb-8\"\n            >\n              <motion.path \n                d=\"M12 22c0-4-3-6-3-9s3-5 3-5 3 2 3 5-3 5-3 9z\" \n                initial={{ pathLength: 0, opacity: 0, fill: \"rgba(233, 143, 167, 0)\" }}\n                animate={{ pathLength: 1, opacity: 1, fill: \"rgba(233, 143, 167, 0.1)\" }}\n                transition={{ duration: 1.5, ease: \"easeInOut\" }}\n              />\n              <motion.path \n                d=\"M12 22V13\" \n                initial={{ pathLength: 0, opacity: 0 }}\n                animate={{ pathLength: 1, opacity: 1 }}\n                transition={{ duration: 1, delay: 0.5, ease: \"easeInOut\" }}\n              />\n              <motion.path \n                d=\"M12 16s-3-2-4-5 1-4 1-4\" \n                initial={{ pathLength: 0, opacity: 0 }}\n                animate={{ pathLength: 1, opacity: 1 }}\n                transition={{ duration: 1, delay: 0.8, ease: \"easeInOut\" }}\n              />\n              <motion.path \n                d=\"M12 16s3-2 4-5-1-4-1-4\" \n                initial={{ pathLength: 0, opacity: 0 }}\n                animate={{ pathLength: 1, opacity: 1 }}\n                transition={{ duration: 1, delay: 0.8, ease: \"easeInOut\" }}\n              />\n            </motion.svg>\n\n            {/* Branding */}\n            <motion.div\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              transition={{ duration: 0.8, delay: 0.5 }}\n              className=\"text-center\"\n            >\n              <span className=\"font-serif text-4xl md:text-5xl tracking-wide text-cafe-teal block\">\n                Blueberrys<span className=\"italic text-cafe-pink ml-1\">Caf\303\251</span>\n              </span>\n            </motion.div>\n\n            {/* Elegant Progress Line */}\n            <div className=\"w-64 h-[1px] bg-cafe-teal/20 mt-10 overflow-hidden relative\">\n              <motion.div \n                className=\"absolute top-0 left-0 h-full bg-cafe-teal\"\n                initial={{ width: \"0%\" }}\n                animate={{ width: \"100%\" }}\n                transition={{ duration: 2, ease: [0.76, 0, 0.24, 1] }}\n              />\n            </div>\n            \n            {/* Status Text */}\n            <motion.span \n              className=\"mt-6 uppercase tracking-[0.4em] text-[9px] text-cafe-teal/60 font-medium\"\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              transition={{ duration: 0.8, delay: 1 }}\n            >\n              Preparing your experience\n            </motion.span>\n          </div>\n        </motion.div>\n      )}\n    </AnimatePresence>\n  );\n}\n"
    }
