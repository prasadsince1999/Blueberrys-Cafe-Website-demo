    replacement_infos {
      original_chunk {
        target_content: "import { motion, useScroll, useTransform } from \'motion/react\';\nimport { useRef } from \'react\';\nimport { PlaceholderImage } from \'./ui/PlaceholderImage\';\n\nexport function Footer() {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\"start end\", \"end end\"]\n  });\n\n  const titleY = useTransform(scrollYProgress, [0, 1], [100, 0]);\n  const opacity = useTransform(scrollYProgress, [0, 0.5, 1], [0, 0.5, 1]);\n\n  return (\n    <footer ref={containerRef} className=\"bg-cafe-cream relative overflow-hidden pt-24 md:pt-40 pb-12 border-t border-cafe-teal/20\">\n      \n      {/* Decorative Floral Background */}\n      <div className=\"absolute right-0 bottom-0 w-1/2 h-[120%] pointer-events-none opacity-40 mix-blend-multiply\">\n        <PlaceholderImage label=\"Floral Corner Decor\" className=\"w-full h-full object-cover\" />\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12 relative z-10\">\n        \n        <motion.div \n          style={{ y: titleY, opacity }}\n          className=\"mb-24 md:mb-40 max-w-3xl\"\n        >\n          <span className=\"text-cafe-teal uppercase tracking-[0.3em] text-sm font-medium mb-6 block\">\n            Until the next cup\n          </span>\n          <h2 className=\"font-serif text-5xl md:text-7xl lg:text-8xl text-cafe-teal leading-tight\">\n            See you at <br/>\n            <span className=\"italic text-cafe-pink\">Blueberrys.</span>\n          </h2>\n        </motion.div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-8 border-t border-cafe-teal/20 pt-12\">\n          \n          <div className=\"md:col-span-1\">\n            <a href=\"#\" className=\"font-serif text-2xl tracking-wide text-cafe-teal block mb-6\">\n              Blueberrys<span className=\"italic text-cafe-pink ml-1\">Caf\303\251</span>\n            </a>\n            <p className=\"text-sm text-cafe-text/60 font-light leading-relaxed max-w-xs\">\n              A floral garden caf\303\251 designed for beautiful moments, good food, and perfect coffee.\n            </p>\n          </div>\n\n          <div>\n            <h4 className=\"uppercase tracking-widest text-xs font-medium text-cafe-teal mb-6\">Visit</h4>\n            <ul className=\"space-y-3 text-sm text-cafe-text/80 font-light\">\n              <li>123 Floral Avenue</li>\n              <li>Garden District</li>\n              <li>City Name, 12345</li>\n              <li className=\"pt-2\">\n                <a href=\"#\" className=\"text-cafe-pink hover:text-cafe-teal transition-colors\">Get Directions</a>\n              </li>\n            </ul>\n          </div>\n\n          <div>\n            <h4 className=\"uppercase tracking-widest text-xs font-medium text-cafe-teal mb-6\">Contact</h4>\n            <ul className=\"space-y-3 text-sm text-cafe-text/80 font-light\">\n              <li>+91 98765 43210</li>\n              <li>hello@blueberryscafe.com</li>\n              <li className=\"pt-2\">\n                <a href=\"#reserve\" className=\"text-cafe-pink hover:text-cafe-teal transition-colors\">Reserve a Table</a>\n              </li>\n            </ul>\n          </div>\n\n          <div>\n            <h4 className=\"uppercase tracking-widest text-xs font-medium text-cafe-teal mb-6\">Social</h4>\n            <ul className=\"space-y-3 text-sm text-cafe-text/80 font-light\">\n              <li><a href=\"#\" className=\"hover:text-cafe-pink transition-colors\">Instagram</a></li>\n              <li><a href=\"#\" className=\"hover:text-cafe-pink transition-colors\">Facebook</a></li>\n              <li><a href=\"#\" className=\"hover:text-cafe-pink transition-colors\">Swiggy</a></li>\n            </ul>\n          </div>\n\n        </div>\n\n        <div className=\"mt-24 text-center md:text-left flex flex-col md:flex-row justify-between items-center text-xs text-cafe-text/40 font-light uppercase tracking-wider\">\n          <p>&copy; {new Date().getFullYear()} Blueberrys Caf\303\251. All rights reserved.</p>\n          <div className=\"flex gap-4 mt-4 md:mt-0\">\n            <a href=\"#\" className=\"hover:text-cafe-teal transition-colors\">Privacy</a>\n            <a href=\"#\" className=\"hover:text-cafe-teal transition-colors\">Terms</a>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n}"
        replacement_content: "import { motion, useScroll, useTransform } from \'motion/react\';\nimport { useRef } from \'react\';\nimport { PlaceholderImage } from \'./ui/PlaceholderImage\';\nimport { useTransition } from \'../context/TransitionContext\';\n\nexport function Footer() {\n  const containerRef = useRef<HTMLDivElement>(null);\n  const { navigateTo } = useTransition();\n\n  const handleNavClick = (e: React.MouseEvent<HTMLAnchorElement>, href: string) => {\n    if (href.startsWith(\'#\')) {\n      e.preventDefault();\n      navigateTo(href);\n    }\n  };\n\n  const { scrollYProgress } = useScroll({\n    target: containerRef,\n    offset: [\"start end\", \"end end\"]\n  });\n\n  const titleY = useTransform(scrollYProgress, [0, 1], [100, 0]);\n  const opacity = useTransform(scrollYProgress, [0, 0.5, 1], [0, 0.5, 1]);\n\n  return (\n    <footer ref={containerRef} className=\"bg-cafe-cream relative overflow-hidden pt-24 md:pt-40 pb-12 border-t border-cafe-teal/20\">\n      \n      {/* Decorative Floral Background */}\n      <div className=\"absolute right-0 bottom-0 w-1/2 h-[120%] pointer-events-none opacity-40 mix-blend-multiply\">\n        <PlaceholderImage label=\"Floral Corner Decor\" className=\"w-full h-full object-cover\" />\n      </div>\n\n      <div className=\"max-w-7xl mx-auto px-6 md:px-12 relative z-10\">\n        \n        <motion.div \n          style={{ y: titleY, opacity }}\n          className=\"mb-24 md:mb-40 max-w-3xl\"\n        >\n          <span className=\"text-cafe-teal uppercase tracking-[0.3em] text-sm font-medium mb-6 block\">\n            Until the next cup\n          </span>\n          <h2 className=\"font-serif text-5xl md:text-7xl lg:text-8xl text-cafe-teal leading-tight\">\n            See you at <br/>\n            <span className=\"italic text-cafe-pink\">Blueberrys.</span>\n          </h2>\n        </motion.div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-4 gap-12 md:gap-8 border-t border-cafe-teal/20 pt-12\">\n          \n          <div className=\"md:col-span-1\">\n            <a \n              href=\"#\" \n              onClick={(e) => handleNavClick(e, \'#\')}\n              className=\"font-serif text-2xl tracking-wide text-cafe-teal block mb-6\"\n            >\n              Blueberrys<span className=\"italic text-cafe-pink ml-1\">Caf\303\251</span>\n            </a>\n            <p className=\"text-sm text-cafe-text/60 font-light leading-relaxed max-w-xs\">\n              A floral garden caf\303\251 designed for beautiful moments, good food, and perfect coffee.\n            </p>\n          </div>\n\n          <div>\n            <h4 className=\"uppercase tracking-widest text-xs font-medium text-cafe-teal mb-6\">Visit</h4>\n            <ul className=\"space-y-3 text-sm text-cafe-text/80 font-light\">\n              <li>123 Floral Avenue</li>\n              <li>Garden District</li>\n              <li>City Name, 12345</li>\n              <li className=\"pt-2\">\n                <a href=\"#\" className=\"text-cafe-pink hover:text-cafe-teal transition-colors\">Get Directions</a>\n              </li>\n            </ul>\n          </div>\n\n          <div>\n            <h4 className=\"uppercase tracking-widest text-xs font-medium text-cafe-teal mb-6\">Contact</h4>\n            <ul className=\"space-y-3 text-sm text-cafe-text/80 font-light\">\n              <li>+91 98765 43210</li>\n              <li>hello@blueberryscafe.com</li>\n              <li className=\"pt-2\">\n                <a \n                  href=\"#reserve\" \n                  onClick={(e) => handleNavClick(e, \'#reserve\')}\n                  className=\"text-cafe-pink hover:text-cafe-teal transition-colors\"\n                >\n                  Reserve a Table\n                </a>\n              </li>\n            </ul>\n          </div>\n\n          <div>\n            <h4 className=\"uppercase tracking-widest text-xs font-medium text-cafe-teal mb-6\">Social</h4>\n            <ul className=\"space-y-3 text-sm text-cafe-text/80 font-light\">\n              <li><a href=\"#\" className=\"hover:text-cafe-pink transition-colors\">Instagram</a></li>\n              <li><a href=\"#\" className=\"hover:text-cafe-pink transition-colors\">Facebook</a></li>\n              <li><a href=\"#\" className=\"hover:text-cafe-pink transition-colors\">Swiggy</a></li>\n            </ul>\n          </div>\n\n        </div>\n\n        <div className=\"mt-24 text-center md:text-left flex flex-col md:flex-row justify-between items-center text-xs text-cafe-text/40 font-light uppercase tracking-wider\">\n          <p>&copy; {new Date().getFullYear()} Blueberrys Caf\303\251. All rights reserved.</p>\n          <div className=\"flex gap-4 mt-4 md:mt-0\">\n            <a href=\"#\" className=\"hover:text-cafe-teal transition-colors\">Privacy</a>\n            <a href=\"#\" className=\"hover:text-cafe-teal transition-colors\">Terms</a>\n          </div>\n        </div>\n      </div>\n    </footer>\n  );\n}"
      }
