    replacement_infos {
      original_chunk {
        target_content: "import { useState, useEffect } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { Menu, X } from \'lucide-react\';\nimport { cn } from \'../lib/utils\';\n\nexport function Navigation() {\n  const [isScrolled, setIsScrolled] = useState(false);\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setIsScrolled(window.scrollY > 50);\n    };\n    window.addEventListener(\'scroll\', handleScroll);\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const navLinks = [\n    { name: \'Home\', href: \'#\' },\n    { name: \'Our Caf\303\251\', href: \'#our-cafe\' },\n    { name: \'Menu\', href: \'#menu\' },\n    { name: \'Gallery\', href: \'#gallery\' },\n    { name: \'Experience\', href: \'#experience\' },\n  ];\n\n  return (\n    <>\n      <header\n        className={cn(\n          \'fixed top-0 left-0 right-0 z-50 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]\',\n          isScrolled ? \'bg-cafe-cream/90 backdrop-blur-md shadow-sm py-4\' : \'bg-transparent py-8\'\n        )}\n      >\n        <div className=\"max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between\">\n          \n          {/* Logo */}\n          <div className=\"flex-1 md:flex-none\">\n            <a href=\"#\" className=\"font-serif text-2xl tracking-wide text-cafe-teal block\">\n              Blueberrys<span className=\"italic text-cafe-pink ml-1\">Caf\303\251</span>\n            </a>\n          </div>\n\n          {/* Desktop Links */}\n          <nav className=\"hidden md:flex flex-1 justify-center items-center space-x-8\">\n            {navLinks.map((link) => (\n              <a\n                key={link.name}\n                href={link.href}\n                className=\"text-[13px] uppercase tracking-[0.15em] font-medium text-cafe-text hover:text-cafe-teal transition-colors\"\n              >\n                {link.name}\n              </a>\n            ))}\n          </nav>\n\n          {/* Desktop Actions */}\n          <div className=\"hidden md:flex flex-1 justify-end items-center space-x-6\">\n            <a href=\"#order\" className=\"text-[13px] uppercase tracking-[0.15em] font-medium text-cafe-teal hover:text-cafe-text transition-colors\">\n              Order Online\n            </a>\n            <a \n              href=\"#reserve\" \n              className=\"px-6 py-3 border border-cafe-teal text-cafe-teal text-[13px] uppercase tracking-[0.15em] font-medium hover:bg-cafe-teal hover:text-cafe-ivory transition-colors\"\n            >\n              Reserve\n            </a>\n          </div>\n\n          {/* Mobile Menu Toggle */}\n          <button\n            className=\"md:hidden text-cafe-text z-50 p-2 -mr-2\"\n            onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}\n          >\n            {isMobileMenuOpen ? <X strokeWidth={1.5} size={28} /> : <Menu strokeWidth={1.5} size={28} />}\n          </button>\n        </div>\n      </header>\n\n      {/* Mobile Menu Overlay */}\n      <AnimatePresence>\n        {isMobileMenuOpen && (\n          <motion.div\n            initial={{ opacity: 0, y: -20 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -20 }}\n            transition={{ duration: 0.5, ease: [0.16, 1, 0.3, 1] }}\n            className=\"fixed inset-0 z-40 bg-cafe-ivory flex flex-col items-center justify-center pt-20 pb-10 px-6\"\n          >\n            <div className=\"absolute inset-0 opacity-20 pointer-events-none\" style={{ backgroundImage: \'radial-gradient(var(--color-cafe-pink) 1px, transparent 1px)\', backgroundSize: \'40px 40px\' }} />\n            \n            <nav className=\"flex flex-col items-center justify-center space-y-8 text-center relative z-10 flex-1\">\n              {navLinks.map((link) => (\n                <a\n                  key={link.name}\n                  href={link.href}\n                  onClick={() => setIsMobileMenuOpen(false)}\n                  className=\"font-serif text-4xl text-cafe-teal italic hover:text-cafe-pink transition-colors\"\n                >\n                  {link.name}\n                </a>\n              ))}\n            </nav>\n\n            <div className=\"flex flex-col space-y-4 w-full max-w-sm relative z-10 mt-12\">\n              <a \n                href=\"#order\" \n                onClick={() => setIsMobileMenuOpen(false)}\n                className=\"w-full py-4 text-center bg-cafe-cream text-cafe-teal uppercase tracking-[0.2em] text-sm font-medium border border-cafe-teal/20\"\n              >\n                Order on Swiggy\n              </a>\n              <a \n                href=\"#reserve\" \n                onClick={() => setIsMobileMenuOpen(false)}\n                className=\"w-full py-4 text-center bg-cafe-teal text-cafe-ivory uppercase tracking-[0.2em] text-sm font-medium\"\n              >\n                Reserve a Table\n              </a>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </>\n  );\n}"
        replacement_content: "import { useState, useEffect } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { Menu, X } from \'lucide-react\';\nimport { cn } from \'../lib/utils\';\nimport { useTransition } from \'../context/TransitionContext\';\n\nexport function Navigation() {\n  const [isScrolled, setIsScrolled] = useState(false);\n  const [isMobileMenuOpen, setIsMobileMenuOpen] = useState(false);\n  const { navigateTo } = useTransition();\n\n  useEffect(() => {\n    const handleScroll = () => {\n      setIsScrolled(window.scrollY > 50);\n    };\n    window.addEventListener(\'scroll\', handleScroll);\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  const handleNavClick = (e: React.MouseEvent<HTMLAnchorElement>, href: string) => {\n    e.preventDefault();\n    if (isMobileMenuOpen) setIsMobileMenuOpen(false);\n    navigateTo(href);\n  };\n\n  const navLinks = [\n    { name: \'Home\', href: \'#\' },\n    { name: \'Our Caf\303\251\', href: \'#our-cafe\' },\n    { name: \'Menu\', href: \'#menu\' },\n    { name: \'Gallery\', href: \'#gallery\' },\n    { name: \'Experience\', href: \'#experience\' },\n  ];\n\n  return (\n    <>\n      <header\n        className={cn(\n          \'fixed top-0 left-0 right-0 z-50 transition-all duration-700 ease-[cubic-bezier(0.16,1,0.3,1)]\',\n          isScrolled ? \'bg-cafe-cream/90 backdrop-blur-md shadow-sm py-4\' : \'bg-transparent py-8\'\n        )}\n      >\n        <div className=\"max-w-7xl mx-auto px-6 md:px-12 flex items-center justify-between\">\n          \n          {/* Logo */}\n          <div className=\"flex-1 md:flex-none\">\n            <a \n              href=\"#\" \n              onClick={(e) => handleNavClick(e, \'#\')}\n              className=\"font-serif text-2xl tracking-wide text-cafe-teal block\"\n            >\n              Blueberrys<span className=\"italic text-cafe-pink ml-1\">Caf\303\251</span>\n            </a>\n          </div>\n\n          {/* Desktop Links */}\n          <nav className=\"hidden md:flex flex-1 justify-center items-center space-x-8\">\n            {navLinks.map((link) => (\n              <a\n                key={link.name}\n                href={link.href}\n                onClick={(e) => handleNavClick(e, link.href)}\n                className=\"text-[13px] uppercase tracking-[0.15em] font-medium text-cafe-text hover:text-cafe-teal transition-colors\"\n              >\n                {link.name}\n              </a>\n            ))}\n          </nav>\n\n          {/* Desktop Actions */}\n          <div className=\"hidden md:flex flex-1 justify-end items-center space-x-6\">\n            <a \n              href=\"#order\" \n              onClick={(e) => handleNavClick(e, \'#order\')}\n              className=\"text-[13px] uppercase tracking-[0.15em] font-medium text-cafe-teal hover:text-cafe-text transition-colors\"\n            >\n              Order Online\n            </a>\n            <a \n              href=\"#reserve\" \n              onClick={(e) => handleNavClick(e, \'#reserve\')}\n              className=\"px-6 py-3 border border-cafe-teal text-cafe-teal text-[13px] uppercase tracking-[0.15em] font-medium hover:bg-cafe-teal hover:text-cafe-ivory transition-colors\"\n            >\n              Reserve\n            </a>\n          </div>\n\n          {/* Mobile Menu Toggle */}\n          <button\n            className=\"md:hidden text-cafe-text z-50 p-2 -mr-2\"\n            onClick={() => setIsMobileMenuOpen(!isMobileMenuOpen)}\n          >\n            {isMobileMenuOpen ? <X strokeWidth={1.5} size={28} /> : <Menu strokeWidth={1.5} size={28} />}\n          </button>\n        </div>\n      </header>\n\n      {/* Mobile Menu Overlay */}\n      <AnimatePresence>\n        {isMobileMenuOpen && (\n          <motion.div\n            initial={{ opacity: 0, y: -20 }}\n            animate={{ opacity: 1, y: 0 }}\n            exit={{ opacity: 0, y: -20 }}\n            transition={{ duration: 0.5, ease: [0.16, 1, 0.3, 1] }}\n            className=\"fixed inset-0 z-40 bg-cafe-ivory flex flex-col items-center justify-center pt-20 pb-10 px-6\"\n          >\n            <div className=\"absolute inset-0 opacity-20 pointer-events-none\" style={{ backgroundImage: \'radial-gradient(var(--color-cafe-pink) 1px, transparent 1px)\', backgroundSize: \'40px 40px\' }} />\n            \n            <nav className=\"flex flex-col items-center justify-center space-y-8 text-center relative z-10 flex-1\">\n              {navLinks.map((link) => (\n                <a\n                  key={link.name}\n                  href={link.href}\n                  onClick={(e) => handleNavClick(e, link.href)}\n                  className=\"font-serif text-4xl text-cafe-teal italic hover:text-cafe-pink transition-colors\"\n                >\n                  {link.name}\n                </a>\n              ))}\n            </nav>\n\n            <div className=\"flex flex-col space-y-4 w-full max-w-sm relative z-10 mt-12\">\n              <a \n                href=\"#order\" \n                onClick={(e) => handleNavClick(e, \'#order\')}\n                className=\"w-full py-4 text-center bg-cafe-cream text-cafe-teal uppercase tracking-[0.2em] text-sm font-medium border border-cafe-teal/20\"\n              >\n                Order on Swiggy\n              </a>\n              <a \n                href=\"#reserve\" \n                onClick={(e) => handleNavClick(e, \'#reserve\')}\n                className=\"w-full py-4 text-center bg-cafe-teal text-cafe-ivory uppercase tracking-[0.2em] text-sm font-medium\"\n              >\n                Reserve a Table\n              </a>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </>\n  );\n}"
      }
